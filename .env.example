# Copy to email-mcp.env (gitignored) and fill in real values. Never commit real values.

# IMAP server used to read/manage mail
IMAP_HOST=
IMAP_PORT=993

# SMTP server used to send mail
SMTP_HOST=
SMTP_PORT=465

# JSON object mapping each account's email address to its password, e.g.
# EMAIL_ACCOUNTS={"user@example.com":"app-password"}
EMAIL_ACCOUNTS=

# Address/port the MCP server binds to
BIND_HOST=127.0.0.1
BIND_PORT=8084
